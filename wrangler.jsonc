{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "philosophy-luciana-digital",
  "main": "worker.js",
  "compatibility_date": "2026-04-28",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "philosophy.luciana.digital",
      "custom_domain": true,
      "zone_name": "luciana.digital"
    }
  ]
}
